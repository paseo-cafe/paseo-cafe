{
  "include": ["**/*.ts", "**/*.tsx"],
  // plugin/ is a separate project (own package.json, tsconfig, deps, and
  // `npm run typecheck`) that ships to a Paseo daemon, not this app's
  // bundle — it has no business being checked with this tsconfig's DOM lib
  // and vite/client types. Typecheck it from plugin/ itself.
  "exclude": ["plugin"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
